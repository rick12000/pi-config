{
  "lastChangelogVersion": "0.99.1",
  "theme": "modern-night",
  "defaultProvider": "local-qwen",
  "defaultModel": "piccolo-large",
  "modelThinkingLevels": {
    "local-qwen/krillin-average": "medium"
  },
  "subagents": {
    "defaultModel": "local-qwen/piccolo-large",
    "defaultThinking": "off",
    "defaultSubagentContext": "fresh",
    "defaultSubagentOnlyExtensions": [
      "C:/Users/ricca/.pi/agent/extensions/command-gate.ts"
    ],
    "agentOverrides": {
      "scout": {
        "thinking": false,
        "defaultContext": "fresh",
        "output": false,
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "contact_supervisor"
        ]
      }
    }
  },
  "packages": [
    "npm:pi-rewind",
    "npm:pi-subagents",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-context-view",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-web-access",
    "npm:billion-context"
  ],
  "tuiMode": "fullscreen",
  "editorPaddingX": 2,
  "outputPad": 1,
  "autocompleteMaxVisible": 5,
  "quietStartup": true,
  "terminal": {
    "trueColor": "auto",
    "hyperlinks": "auto",
    "showImages": true
  }
}